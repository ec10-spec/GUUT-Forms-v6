# ---------------------------------------------------------------------------
# PLATFORM DATABASE (ours): accounts, companies, logs, form directory, AI usage.
# Customer forms and responses are NEVER stored here: they live in each
# company's OWN database, which its admin links under Settings -> Database. Leave blank in dev for a throwaway in-memory DB.
# REQUIRED in production.
# ---------------------------------------------------------------------------
MONGO_URI=
# Name of the platform database. Without it, the name in MONGO_URI is used, else "guut_platform".
# (Older deploys ended up in "test": see SETUP.md, "Database: moving off test".)
# PLATFORM_DB_NAME=guut_platform

# Secrets (REQUIRED in production, use two different long random strings):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Encrypts users' AI API keys and companies' database URIs at rest.
# Changing it later makes saved keys/URIs undecryptable.
ENCRYPTION_KEY=

# First superadmin, created on startup if it doesn't exist yet.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Admin

# Anyone can create an account (individual, business, or employee joining a company code).
# Set to false to close sign-ups.
SIGNUPS_ENABLED=true
# Sign-ups per IP per hour
SIGNUP_RATE_LIMIT=30
# Email confirmation at sign-up: auto (default) = required whenever email is set up
# below, true = always (sign-up refused without email), false = never.
REQUIRE_EMAIL_VERIFICATION=auto

# Hosted storage for individuals and for businesses without their own database. A SEPARATE
# database from MONGO_URI (which holds accounts). Optionally give it its own cluster.
HOSTED_DB_NAME=guut_hosted
HOSTED_DB_URI=

# Pricing: edit backend/utils/plans.js. Individuals are unlimited unless you set these
# (empty = unlimited):
INDIVIDUAL_MAX_FORMS=
INDIVIDUAL_MAX_RESPONSES_PER_MONTH=
# Storage cap for individual accounts in MB (decimals ok, e.g. 100). Empty = unlimited.
INDIVIDUAL_MAX_STORAGE_MB=
# true = block businesses whose subscription isn't trial/active and enforce plan seat limits.
# Leave false until payments are set up (the platform team sets each company's status by hand).
ENFORCE_BILLING=false

# ---------------------------------------------------------------------------
# EMAIL (confirmation, password reset, notifications). Pick ONE way to send.
# Leave all blank to switch email off (the app works the same without it).
# Option 1, Brevo API (works on Render's free plan, which blocks SMTP ports).
#   Free: 300 emails a day. The sender can be a verified Gmail address.
BREVO_API_KEY=
# Option 2, SMTP (Gmail app password, Resend, SES...). Needs a paid Render plan or a VPS.
#   Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=the Gmail address,
#   SMTP_PASS=a 16-character app password (Google Account > Security > App passwords).
SMTP_HOST=
SMTP_PORT=587
# true only for port 465
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender shown on every email. With Brevo or Gmail it must be the verified Gmail address.
MAIL_FROM="GUUT Forms <guutforms.test@gmail.com>"
# Public address of this app, used for links inside emails. On Render this
# defaults to the service URL automatically.
APP_URL=


# Logs (stored in the platform DB, auto-deleted after N days)
LOG_RETENTION_DAYS=30

# AI
# Per-user daily cap (input + output tokens, all AI features). Superadmins are exempt.
DAILY_TOKEN_LIMIT=100000
# Ceiling for one AI form-generation call
MAX_TOKENS_PER_CALL=3000
# Ceiling for one reply in the response-analysis chat (users pick up to this in the chat box)
MAX_TOKENS_PER_ANALYSIS=4000
# Cost estimates use per-model list prices with input and output priced separately (utils/pricing.js).
# Override or add models (USD per million tokens, [input, output]):
# AI_PRICES_JSON={"claude-sonnet":[3,15],"gpt-4o":[2.5,10]}
# Defaults used when a user hasn't typed their own model name in Settings
DEFAULT_ANTHROPIC_MODEL=claude-sonnet-4-6
DEFAULT_OPENAI_MODEL=gpt-4o

# Optional: lock CORS to your frontend origin(s), comma separated.
# Leave blank for same-origin deploys (the normal Render setup).
CORS_ORIGIN=

PORT=4000

# Free AI credit for accounts without their own key (uses this platform key until the estimate is used up)
# PLATFORM_AI_KEY=
# PLATFORM_AI_PROVIDER=anthropic
# FREE_AI_CREDIT_USD=5
# (credit spend is estimated with the same per-model prices as above)
